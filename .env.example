# Frontend (Vite). Defaults for the public URL + publishable key are committed
# in src/lib/config.js (they are client-safe by design — RLS protects the data);
# set these to point at a different Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to 'true' to force the localStorage demo backend (no Supabase).
VITE_DEMO_MODE=

# Server-side only — used by scripts/import-bible.mjs. NEVER expose to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
